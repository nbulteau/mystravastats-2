{
    "name": "mystravastats-front",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=26.5.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "build-only": "vite build",
        "build:check": "npm run build-only && node scripts/check-bundle-budget.mjs",
        "type-check": "vue-tsc --build --force",
        "test:unit": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
        "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
        "serve": "vite"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@revolist/vue3-datagrid": "^4.27.0",
        "bootstrap": "^5.3.8",
        "highcharts": "^13.0.1",
        "highcharts-vue": "^2.0.2",
        "leaflet": "^1.9.4",
        "leaflet-defaulticon-compatibility": "^0.1.2",
        "mitt": "^3.0.1",
        "pinia": "^4.0.3",
        "sass": "^1.103.1",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0"
    },
    "optionalDependencies": {
        "@rolldown/binding-darwin-arm64": "^1.2.5"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@rushstack/eslint-patch": "^1.16.1",
        "@tsconfig/node20": "^20.1.10",
        "@types/bootstrap": "^5.2.11",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.3.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.11",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.9.1",
        "eslint-plugin-vue": "^10.10.0",
        "npm-run-all2": "^9.0.3",
        "typescript": "~6.0.3",
        "vite": "^8.2.2",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11",
        "webpack-bundle-analyzer": "^5.3.2"
    }
}
